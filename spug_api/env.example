# ============================================
# Spug 环境配置模板
# 复制为 .env 并按实际环境填写
# ============================================

# 运行环境: dev / prod
SPUG_ENV=dev

# Django Secret Key (生产环境必须修改为随机字符串)
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=vk0do47)egwzz!uk49%(y3s(fpx4+ha@ugt-hcv&%&d@hwr&p7

# 调试模式 (生产环境必须为 false)
DEBUG=true

# 允许的主机名 (逗号分隔, 生产环境必须指定具体域名)
ALLOWED_HOSTS=*

# --- 数据库配置 ---
# 引擎: sqlite / postgresql / mysql
DB_ENGINE=sqlite
DB_NAME=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# --- Redis 配置 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# --- Channels (WebSocket) Redis ---
CHANNELS_REDIS_HOST=127.0.0.1
CHANNELS_REDIS_PORT=6379

# --- Token 有效期 (秒) ---
TOKEN_TTL=28800